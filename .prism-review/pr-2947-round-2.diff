+      app.kubernetes.io/component: master
+  policyTypes:
+    - Egress
+  egress:
+    - ports:
+        - port: 53
+          protocol: UDP
+        - port: 53
+          protocol: TCP
+      to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: kube-system
+---
+# Allow intra-ns ingress from volume/filer/s3 on :9333/:19333
+apiVersion: networking.k8s.io/v1
