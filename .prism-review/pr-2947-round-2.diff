++# Receives from: volume (register/heartbeat), filer (metadata), s3 (metadata via filer)
++# Sends to: (responds only; master is essentially a server)
++# =============================================================================
++
++# Default deny-all for seaweedfs-master pod
++apiVersion: networking.k8s.io/v1
++kind: NetworkPolicy
++metadata:
++  name: seaweedfs-master-default-deny
