{
  "tagOwners": {
    "tag:nixos":         ["ben@"],
    // Per-service proxies are cluster-managed workloads; homeops@ (the
    // operator identity) owns them because no human owner is appropriate
    // for a workload that any cluster admin might need to redeploy.
    "tag:ts-prometheus": ["homeops@"],
    "tag:ts-loki":       ["homeops@"],
    // Fleet-metrics remote_write ingest proxy (issue #3386). Same rationale
    // as ts-prometheus / ts-loki: cluster-managed workload, no human owner
    // fits; homeops@ owns the machine identity so any cluster admin can
    // redeploy without needing to re-own the tag.
    "tag:ts-metrics-ingest": ["homeops@"],
    // Shared tailnet-only web-UI proxy (pilot #3466). Same rationale as the
    // per-service proxies above: cluster-managed workload, no human owner
    // fits, so homeops@ owns the machine identity. One ts-web node fronts
    // every *.ts.<domain> web UI (prometheus first; Hubble/Longhorn later).
    "tag:ts-web":            ["homeops@"],
    // DNS-over-TLS proxy for blocky (issue #3564). Same rationale as the
    // per-service proxies above: cluster-managed workload, no human owner
    // fits, so homeops@ owns the machine identity. The proxy TCPForwards
    // tailnet :853 to the in-cluster blocky resolver, which terminates DoT
    // on the *.<domain> wildcard cert. Consumer is Android Private DNS.
    "tag:ts-blocky":         ["homeops@"],
    // Tailnet DNS resolver (issue #3576). Same rationale as the per-service
    // proxies above: cluster-managed workload, no human owner fits, so
    // homeops@ owns the machine identity. The node is a blocky instance with
    // a tun-mode tailscale sidecar, so it answers plain DNS on its own
    // tailnet address. A resolver that headscale pushes to a client must be
    // plain and must accept UDP, and neither is possible through the
    // userspace `tailscale serve` proxy pattern the tags above use.
    "tag:ts-dns":            ["homeops@"],
    // k3s control-plane hosts node0/1/2 (issue #3477). Unlike every tag
    // above, these are NOT pods: tailscaled runs on the bare-metal Ubuntu
    // hosts. An in-cluster proxy would be a circular dependency, because
    // headscale itself runs on this cluster -- a cluster outage would then
    // remove the only path in. homeops@ owns the tag for the same reason it
    // owns the proxies: infrastructure identity, no human owner fits.
    //
    // This tag is deliberately NOT a grant destination (read the grant in
    // the grants block for why). It still does two real jobs, so do not
    // delete it as unused:
    //   1. It is the auto-approver identity for the 10.87.42.2/32 route.
    //   2. It keeps the hosts machine-identity nodes. A tagged node must
    //      not have a user_id, so node0/1/2 never inherit the ben@ grants.
    "tag:ts-cp":             ["homeops@"],
  },

  // Route auto-approval (issue #3477). The tag:ts-cp hosts each advertise
  // 10.87.42.2/32 -- the kube-vip control-plane VIP. Without this entry an
  // operator must run `headscale nodes approve-routes ...` by hand after
  // every re-registration of every host, and the control-plane path stays
  // down until they do.
  //
  // `autoApprovers` is a SIBLING of `grants`, not a key inside it.
  // Approval and access are separate decisions: this block says WHICH nodes
  // may advertise the prefix; the grant below says WHO may then use it.
  //
  // The prefix must match what the hosts advertise EXACTLY. Auto-approval
  // covers a route equal to or narrower than a key here, never a broader
  // one, so a host that advertised 10.87.42.0/24 would not be approved.
  "autoApprovers": {
    "routes": {
      "10.87.42.2/32": ["tag:ts-cp"],
    },
  },

  // Least-privilege access: tag:nixos peers may reach ONLY
  //   tag:ts-prometheus tcp/9090 and tag:ts-loki tcp/3100.
  // Everything else (SSH, other ports on the same tags, other cluster
  // services) is denied by the default-deny posture of the tailnet:
  // absence of a grant is a deny.
  //
  // Access to services is via per-service tailscale proxy pods (design
  // #3377). The former in-cluster subnet router that advertised the k3s
  // Service CIDR (10.43.0.0/16) was retired in #3379 because forwarded
  // traffic hitting a ClusterIP is not translated by Cilium socket-LB --
  // socket-LB only translates locally-originated `connect()` calls, not
  // routed packets. See #3377 for the full root cause.
  "grants": [
    // Per-service-proxy path (design #3377).
    {
      "src": ["tag:nixos"],
      "dst": ["tag:ts-prometheus"],
      "ip":  ["tcp:9090"],
    },
    {
      "src": ["tag:nixos"],
      "dst": ["tag:ts-loki"],
      "ip":  ["tcp:3100"],
    },
    // Grant Ben's personal user-identity devices (headscale user
    // ben@, e.g. navi, bens-s25) the same least-privilege
    // observability access as the tag:nixos machines. These devices
    // register without a tag, so they're granted by user src
    // ("ben@") rather than a machine tag.
    {
      "src": ["ben@"],
      "dst": ["tag:ts-prometheus"],
      "ip":  ["tcp:9090"],
    },
    {
      "src": ["ben@"],
      "dst": ["tag:ts-loki"],
      "ip":  ["tcp:3100"],
    },
    // Fleet-metrics remote_write ingest (issue #3386). ONLY tcp:9090 -
    // the fleet-ingest Prometheus's web port also serves the receiver
    // (/api/v1/write) when enableRemoteWriteReceiver is true. No other
    // ports, no other destinations. Deliberately scoped so ben@ devices
    // (which push their own device metrics via Alloy remote_write) get
    // the minimum surface needed to POST samples and query them back.
    {
      "src": ["ben@"],
      "dst": ["tag:ts-metrics-ingest"],
      "ip":  ["tcp:9090"],
    },
    // Tailnet-only web UI (pilot #3466). ben@ devices reach the shared
    // ts-web proxy on tcp:443, and on tcp:80 for the HTTP->HTTPS redirect
    // only (issue #3471) -- traefik's web entrypoint 308s every request to
    // websecure, so no application content is ever served in plaintext on
    // port 80. The proxy TCPForwards to the in-cluster traefik gateway,
    // which terminates TLS and routes by hostname. No other ports. TLS
    // terminates on traefik, not on tailscale, so the base-domain cert
    // limitation does not apply.
    {
      "src": ["ben@"],
      "dst": ["tag:ts-web"],
      "ip":  ["tcp:80", "tcp:443"],
    },
    // DNS-over-TLS to blocky (issue #3564). ONLY tcp:853. The consumer is
    // Android Private DNS, which points at one hostname and speaks DoT for
    // every query on every network the device joins, so ben@ devices are the
    // only source that needs this.
    //
    // No tcp:53 and no udp:53: plaintext DNS over the tailnet is not the
    // point of this path, and the LAN already has its own plaintext route to
    // the same resolver. No tcp:22. The tests block asserts all of that.
    {
      "src": ["ben@"],
      "dst": ["tag:ts-blocky"],
      "ip":  ["tcp:853"],
    },
    // Tailnet DNS resolver (issue #3576). ONLY udp:53 and tcp:53. headscale
    // pushes this node's tailnet address to ben@ devices as their resolver.
    // A client queries a pushed resolver UDP-first and falls back to TCP, so
    // both entries are needed and nothing else is.
    //
    // No tcp:853: this path is plain DNS inside the WireGuard tunnel, which
    // already encrypts every query. No tcp:22. The tests block asserts that.
    {
      "src": ["ben@"],
      "dst": ["tag:ts-dns"],
      "ip":  ["udp:53", "tcp:53"],
    },
    // MPD (Music Player Daemon) control/streaming port 6600. Scoped to ben@
    // devices only; enables device-to-device music access (e.g. navi <-> bens-s25).
    // TCP only, no UDP. Does not widen any other access.
    {
      "src": ["ben@"],
      "dst": ["ben@"],
      "ip":  ["tcp:6600"],
    },
    // Kubernetes control plane over the tailnet (issue #3477). Replaces the
    // public router port-forward of tcp/6443 to the home WAN address, which
    // answered unauthenticated requests from the open internet.
    //
    // READ THIS BEFORE YOU "FIX" THE dst TO tag:ts-cp.
    //
    // The dst is the VIP prefix, not the tag, and that is deliberate. The
    // two tailnet patterns in this file are NOT interchangeable:
    //
    //   Proxy pattern -- every other grant above (tag:ts-prometheus,
    //     tag:ts-loki, tag:ts-metrics-ingest, tag:ts-web). A userspace
    //     tailscale pod TCPForwards the connection, so traffic terminates
    //     on the proxy's OWN tailnet IP. There the tag IS the destination
    //     and dst: [tag] is correct.
    //
    //   Subnet-router pattern -- this grant. The tag:ts-cp hosts forward
    //     packets to an address BEHIND them. headscale resolves a tag dst
    //     to the tagged nodes' own 100.64.0.0/10 addresses only; it never
    //     expands a tag dst to the routes those nodes advertise. With
    //     dst: [tag:ts-cp], ReduceRoutes/CanAccessRoute finds no rule whose
    //     destination overlaps 10.87.42.2/32, strips the prefix from every
    //     ben@ device's AllowedIPs, and --accept-routes then receives no
    //     route at all -- the VIP is unreachable. Upstream states the same
    //     rule in docs/ref/routes.md: "Access to the subnet router itself
    //     is denied."
    //
    // In-tree precedent, checkable with:
    //   git show 0e207ff2e~1:kubernetes/cluster0/apps/networking/headscale/app/config/policy.hujson
    // The retired tag:k8s-router subnet router granted dst: ["prometheus"]
    // and dst: ["loki"] -- /32 hosts behind the router -- and never
    // dst: ["tag:k8s-router"]. Same shape as this grant.
    //
    // Granting tag:ts-cp would also be dead surface, not just redundant:
    // the apiserver serving cert has no 100.64.0.0/10 SAN, so a client that
    // reached a host's tailnet IP on 6443 would fail certificate validation
    // anyway -- and fail in a confusing way.
    //
    // ONLY tcp:6443. No tcp:22: SSH over the tailnet is a separate change
    // (retiring cloudflared for SSH) and must not ride in on this grant.
    // The tests block asserts both halves of that.
    {
      "src": ["ben@"],
      "dst": ["10.87.42.2/32"],
      "ip":  ["tcp:6443"],
    },
  ],

  // Static assertions evaluated on every policy load/boot. If any accept
  // fails or any deny succeeds, headscale logs "policy tests failed at
  // boot" and keeps the previous good policy live. See
  // hscontrol/policy/v2/test.go in juanfont/headscale.
  //
  // Was removed in #3371 (issue #3370) because tag:nixos resolved to zero
  // registered nodes and every assertion tripped the resolver's
  // "resolved to no IP addresses" warning -- which actively misled a live
  // investigation. Restored in #3379 asserting tag:nixos, but no
  // registered device actually carries that tag -- the real devices
  // (m4mac, navi, Ben's S25) register untagged under the ben@ user, so
  // that assertion also resolved to no IP addresses (issue #3398). Fixed
  // here by asserting against ben@, the source actually granted access
  // (#3383). A second test entry sourced from tag:ts-prometheus (a real,
  // registered proxy node) covers cross-tag / unauthorised-source denies
  // that ben@ itself can't exercise, since ben@ is legitimately granted
  // access to tag:ts-metrics-ingest.
  //
  // The #3477 control-plane assertions name the VIP literal 10.87.42.2 and
  // NOT tag:ts-cp. Two reasons, both load-bearing:
  //   1. They must match the grant, whose dst is the VIP prefix. An
  //      assertion on tag:ts-cp would test a path the policy does not
  //      grant and does not need.
  //   2. They must resolve. A test DESTINATION that resolves to no IP
  //      addresses is an error, and evalReachability counts that error as a
  //      failure in `deny` exactly as in `accept`. tag:ts-cp has no
  //      registered node until an operator runs
  //      docs/runbooks/tailnet-control-plane-access.md, so a tag:ts-cp
  //      assertion would fail at boot and re-create the misleading warning
  //      of #3370 / #3398. A bare IP literal resolves to itself whatever
  //      nodes exist, so these assertions pass from the moment this merges
  //      and keep passing after the hosts join.
  //
  // The tag:ts-blocky (#3564) and tag:ts-dns (#3576) assertions DO name a
  // tag, and they are the documented exception to the paragraph above. Read
  // this before you "fix" them to an IP literal or delete them.
  //
  // Each resolves to no IP addresses until the pod behind its tag registers,
  // so between merge and first registration those assertions error with
  // "destination resolved to no IP addresses" and mark their test failed.
  // That is tolerable here, where a tag:ts-cp assertion was not, because of
  // WHICH code path evaluates them. headscale v0.29.3 has two, and they
  // differ:
  //
  //   Boot -- NewPolicyManager in hscontrol/policy/policy.go calls RunTests
  //     and, on failure, only logs "policy tests failed at boot; server
  //     starting anyway". The new policy IS applied. This is the path a
  //     ConfigMap edit takes, because Reloader restarts the pod rather than
  //     sending SIGHUP.
  //   Reload / API write -- SetPolicy in the same file runs evaluateTests
  //     against a sandbox and returns the error WITHOUT mutating live state,
  //     so a failing write is rejected and the previous policy stays live.
  //
  // So this file lands via the warn-and-continue path: the grant goes live,
  // the proxy registers, the tag resolves, and every assertion passes from
  // the next boot onward. There is no chicken-and-egg deadlock. What there
  // IS, until first registration, is a boot warning naming those
  // destinations -- the same misleading-log failure mode as #3370 / #3398.
  // If you are debugging a tailnet problem and see it, check whether the pod
  // behind the named tag has registered before you treat it as the cause.
  //
  // Do NOT run `headscale policy reload` (SIGHUP) while the tag has no
  // registered node: that path rejects the write.
  "tests": [
    {
      "src": "ben@",
      "accept": [
        "tag:ts-prometheus:9090",
        "tag:ts-loki:3100",
        "tag:ts-web:443",       // tailnet-only web UI proxy (#3466)
        "tag:ts-web:80",        // HTTP->HTTPS redirect entrypoint (#3471)
        "tag:ts-blocky:853",    // DoT to blocky for Android Private DNS (#3564)
        "tag:ts-dns:53",        // plain DNS to the pushed tailnet resolver (#3576)
        "10.87.42.2:6443",      // k8s control plane via the tag:ts-cp subnet route (#3477)
      ],
      "deny": [
        "tag:ts-prometheus:22", // no SSH on the prometheus proxy
        "tag:ts-loki:22",       // no SSH on the loki proxy
        "tag:ts-web:9090",      // ben@ reaches ts-web ONLY on tcp:443, not the backend port
        "tag:ts-blocky:22",     // no SSH on the blocky proxy
        "tag:ts-blocky:53",     // the #3564 grant is DoT (853) ONLY -- not plaintext DNS
        "tag:ts-dns:22",        // the #3576 grant is :53 ONLY -- no SSH on the resolver node
        "10.87.42.2:22",        // the #3477 grant is tcp:6443 ONLY -- it must not open SSH on the VIP
      ],
    },
    {
      "src": "tag:ts-prometheus",
      "deny": [
        "tag:ts-loki:3100",           // no cross-tag: loki port from prom node
        "tag:ts-metrics-ingest:9090", // ts-metrics-ingest is not granted to tag:ts-prometheus
        "tag:ts-web:443",             // ts-web is granted to ben@ only, not to tag:ts-prometheus
        "tag:ts-blocky:853",          // ts-blocky is granted to ben@ only, not to tag:ts-prometheus (#3564)
        "tag:ts-dns:53",              // ts-dns is granted to ben@ only, not to tag:ts-prometheus (#3576)
        "10.87.42.2:6443",            // control-plane VIP is granted to ben@ only (#3477)
      ],
    },
  ],
}

