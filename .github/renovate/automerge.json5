{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    // Enable automerge for patch updates (all packages)
    {
      "description": "Auto-merge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    // Enable automerge for minor updates to Docker images
    {
      "description": "Auto-merge minor updates for Docker images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    // Enable automerge for minor updates to Helm charts
    {
      "description": "Auto-merge minor updates for Helm charts",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    // Never auto-merge the seaweedfs Helm chart. The chart's appVersion has
    // shipped image refs that don't exist on Docker Hub twice now (4.29→4.30
    // via #3093 was the most recent; image tag `chrislusf/seaweedfs:4.30`
    // doesn't exist, only variant tags do). Until upstream stops doing this,
    // every seaweedfs chart bump needs human eyes before it lands.
    {
      "description": "Never auto-merge seaweedfs Helm chart (broken appVersion/image-tag bumps)",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["seaweedfs"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": false
    },
    // Enable automerge for GitHub Actions
    {
      "description": "Auto-merge GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    // Disable automerge for major updates (require manual review)
    {
      "description": "Disable auto-merge for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    // Tier 1: Never automerge critical cluster infrastructure (any update type)
    {
      "description": "Never auto-merge Tier 1 critical infrastructure",
      "matchPackageNames": [
        "k3s-io/k3s",
        "rancher/system-upgrade-controller",
        "rancher/k3s-upgrade",
        "cilium",
        "coredns",
        "traefik",
        "fluxcd/flux2",
        "ghcr.io/fluxcd/flux-manifests"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": false
    },
    // Tier 2: Disable automerge for major/minor updates to critical infrastructure (patches allowed)
    {
      "description": "Tier 2: Disable auto-merge for major/minor updates (patches allowed)",
      "matchPackageNames": [
        "cert-manager",
        "trust-manager",
        "cilium",
        "cloudnative-pg",
        "coredns",
        "external-dns",
        "traefik",
        "longhorn"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    // Never auto-merge ghcr.io/tailscale/tailscale (any update type). Four
    // Deployments pin runAsUser/runAsGroup to 65534 on this image, a decision
    // that depends on facts internal to the image (no USER directive, nobody
    // at uid/gid 65534, /tmp mode 1777). ghcr.io images are excluded from the
    // minimumReleaseAge rule in renovate.json5, so without this carve-out a
    // bump opens and auto-merges immediately. See #3662.
    {
      "description": "Never auto-merge ghcr.io/tailscale/tailscale (image-internal uid/gid assumptions, #3662)",
      "matchPackageNames": ["ghcr.io/tailscale/tailscale"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": false
    },
    // Never auto-merge eclipse-mosquitto (any update type). Both mosquitto and
    // mqtt-recorder use this image. mosquitto 2.1 patch releases add new
    // refusals: 2.1.1 and later refuse a symlinked password or ACL file. A
    // future release can refuse a file that the broker does not own (#3893).
    // If the broker refuses passwd or acl, no client can log in, and Home
    // Assistant loses every Zigbee device. Auto-merge lands an update at any
    // time of day, with no person to run the post-deploy test.
    //
    // Owner decision (2026-10-07): this rule stays after #3893 is done.
    // Revisit it when an automated check proves, after each update, that every
    // MQTT user can log in and that the ACL works (see #3898). Then digest,
    // patch and minor updates can auto-merge. Major updates stay manual.
    {
      "description": "Never auto-merge eclipse-mosquitto (a release can refuse passwd or acl and lock out every MQTT client, #3903)",
      "matchPackageNames": ["eclipse-mosquitto"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": false
    },
    // TEMPORARY: never auto-merge the alloy Helm chart (any update type). The
    // Alloy HelmRelease carries a stage.drop with older_than = "45m". It
    // absorbs the one-time re-read when Alloy changes to loki.source.file
    // (#3901). The contract PR of #3901 removes the stage after the restart
    // check of #4060 passes: after an Alloy restart that follows the cutover
    // on all 4 nodes, the new Alloy pods show no older_than_45m drops. A patch
    // update auto-merges, so nothing prompts a person to remove the stage.
    // This hold puts a reminder in each Alloy PR body. The PR that removes the
    // stage.drop must also remove this rule.
    {
      "description": "TEMPORARY: never auto-merge the alloy Helm chart until the 45m stage.drop is removed (#3901)",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["alloy"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": false,
      "prBodyNotes": [
        "**Alloy hold (#3901):** The 45m `stage.drop` in the Alloy `helm-release.yaml` is temporary. The contract PR of #3901 removes the stage and this Renovate rule after the restart check of #4060 passes. This chart update does not depend on that PR, so merge it as normal. Its rollout restarts Alloy, so it can be the restart check. 5 minutes after the rollout completes, read `sum by (pod, reason) (loki_process_dropped_lines_total)`. If the new Alloy pods show an `older_than_45m` series, the read positions did not survive the restart: do not open the contract PR, and report it on #3901. If they show no `older_than_45m` series, and the contract PR does not exist yet, open it."
      ]
    },
    // Disable automerge for databases
    {
      "description": "Disable auto-merge for databases",
      "matchPackagePatterns": [
        "postgres",
        "postgresql",
        "valkey",
        "redis"
      ],
      "matchUpdateTypes": ["major", "minor", "digest"],
      "automerge": false
    },
    // Special handling for home-assistant (calendar versioning)
    {
      "description": "Disable auto-merge for home-assistant (calendar versioning)",
      "matchPackagePatterns": [
        "home-assistant/home-assistant"
      ],
      "automerge": false
    }
  ]
}
