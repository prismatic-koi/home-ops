{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "bash": {
          // Allow gh pr merge without prompting during weekly patching — PRs are
          // reviewed manually before switching to build agent, so approval at
          // merge time is redundant friction.
          "gh pr merge *": "allow"
        }
      }
    }
  }
}
